{
  "description": "At a session's start, measures the repository and the memory and puts a one-line finding into Claude's context when something is over budget or unbacked (nothing when clean); after every reply, measures again and shows the person one reminder when something new crosses a limit, which Claude hears at the next prompt; pushes the memory folder's backup after every reply and when a session ends (only when the folder is a git repository); at the same moments, when the repository turned autosplit on, starts the background worker that prepares the split of a CLAUDE.md over the limits on a branch of its own; runs the commit gate before a git commit that Claude issues, blocking it on a hit; at a session's start, also says in one line when other Claude Code sessions are at work in the repository; and after a git rebase, pull, push or commit that Claude issues, tells Claude, only when there is something to tell, that a number of a numbered list now appears twice, that a build's stamp names a commit the branch no longer holds, or, after a commit as well, that another session waits on this worktree. Every hook runs node with scripts/run.mjs, which finds Python 3 and runs scripts/bowline.py.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "doctor", "--pending"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "doctor", "--brief"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "doctor", "--watch"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "memory", "push", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "autosplit", "--hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "memory", "push", "--hook"],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "autosplit", "--hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "gate", "--hook"],
            "if": "Bash(git commit*)",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-rebase", "--hook"],
            "if": "Bash(git rebase*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-rebase", "--hook"],
            "if": "Bash(git pull*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-push", "--hook"],
            "if": "Bash(git push*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-commit", "--hook"],
            "if": "Bash(git commit*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-rebase", "--hook"],
            "if": "PowerShell(git rebase*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-rebase", "--hook"],
            "if": "PowerShell(git pull*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-push", "--hook"],
            "if": "PowerShell(git push*)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs", "crew", "after-commit", "--hook"],
            "if": "PowerShell(git commit*)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
